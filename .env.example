# Sao chép file này thành .env.local (khi chạy thử trên máy)
# hoặc khai báo 2 biến này trong Vercel > Project > Settings > Environment Variables (khi deploy).
# Lấy giá trị ở Supabase > Project Settings > API. KHÔNG chia sẻ key này công khai ngoài anon key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
